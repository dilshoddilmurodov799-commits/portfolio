# Server-only settings. Copy this file to .env (never committed) for local development, and add the
# same names in Vercel → Project → Settings → Environment Variables for production.
# None of them start with VITE_, so none of them are ever sent to the browser.
# Never put real values in THIS file: it is committed to git.

# Supabase → Project Settings → API (or "API Keys"): the Project URL, and the secret key
# (sb_secret_…, or the legacy service_role key). Never the anon/publishable key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# The admin panel password (/adminpanel). Use a long, unique one.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# 32+ random characters; signs admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters

# From @BotFather, and the chat the alerts go to (see the setup steps).
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
